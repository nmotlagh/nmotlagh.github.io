---
interface Props {
  bibtex: string;
  downloadHref: string;
}

const { bibtex, downloadHref }: Props = Astro.props;
---

<section class="cite surface">
  <div class="cite__header">
    <p class="eyebrow">Cite</p>
    <div class="cite__actions">
      <button class="cite__button" type="button" data-cite-copy>
        <span data-cite-label aria-live="polite">Copy BibTeX</span>
      </button>
      <a class="badge badge--link" href={downloadHref} download>.bib</a>
    </div>
  </div>

  <pre class="cite__code"><code data-cite-source>{bibtex}</code></pre>
</section>

<script>
  document.querySelectorAll('[data-cite-copy]').forEach((button) => {
    const root = button.closest('.cite');
    const label = button.querySelector('[data-cite-label]');
    const source = root?.querySelector('[data-cite-source]');
    if (!label || !source) return;

    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(source.textContent ?? '');
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Text selected; use your copy shortcut';
        const range = document.createRange();
        range.selectNodeContents(source);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        label.textContent = 'Copy BibTeX';
      }, 2400);
    });
  });
</script>

<style>
  .cite {
    padding: var(--pad-card);
  }

  .cite__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cite__header .eyebrow {
    margin: 0;
  }

  .cite__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .cite__button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.8rem;
    border: 0;
    border-radius: 0;
    background: var(--color-tab);
    color: var(--color-text);
    cursor: pointer;
    font: 500 var(--label-md) / 1.2 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .cite__button:hover,
  .cite__button:focus-visible {
    background: var(--color-tab-hover);
    color: var(--color-text);
  }

  .cite__code {
    margin: 1rem 0 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    border: var(--hairline);
    border-radius: 0;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    font: 400 0.78rem / 1.7 var(--font-mono);
    tab-size: 2;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
