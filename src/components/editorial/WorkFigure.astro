---
/**
 * Line-art figures for the Selected work case studies. Ink, hairlines and one
 * accent, drawn in a 240 × 150 box so every figure shares a scale.
 *
 * - outcomes:  the paired-outcome grid (conceptual, no data).
 * - threshold: predictions as dot columns by confidence, cut by the reject
 *              threshold (conceptual, no data).
 * - imagery:   swap the image, measure the change (conceptual, no data).
 */
interface Props {
  kind: 'outcomes' | 'threshold' | 'imagery';
  id: string;
}
const { kind, id }: Props = Astro.props;
const titleId = `${id}-fig-title`;

// Threshold figure: an illustrative confidence histogram (skewed toward high
// confidence) drawn as dot columns and cut by the threshold. Shape only; not data.
const columnHeights = [1, 1, 2, 2, 3, 3, 4, 5, 6, 7, 9, 10, 11, 8];
const cut = 6; // columns before this index fall below the threshold
const colX = (i: number) => 22 + i * 14.4;
const dots = columnHeights.flatMap((h, i) =>
  Array.from({ length: h }, (_, j) => ({ x: colX(i), y: 124 - j * 7.4, below: i < cut })),
);
const tauX = (colX(cut - 1) + colX(cut)) / 2;

const captions: Record<Props['kind'], string> = {
  outcomes: 'Net accuracy change = repaired − harmed',
  threshold: 'Declined guesses are no better than a coin flip',
  imagery: 'Swap the image, measure the change',
};
---

<figure class="work-fig">
  {kind === 'outcomes' && (
    <svg viewBox="0 0 240 150" role="img" aria-labelledby={titleId}>
      <title id={titleId}>
        A two-by-two grid of paired outcomes. A right draft that stays right is preserved; a right draft
        that revision makes wrong is harmed; a wrong draft that revision fixes is repaired; a wrong draft
        that stays wrong is unrecovered.
      </title>
      <g class="fig-ink">
        <rect class="fig-box" x="72" y="34" width="78" height="46" />
        <rect class="fig-dashed" x="150" y="80" width="78" height="46" />
      </g>
      <rect class="fig-harm" x="150" y="34" width="78" height="46" />
      <rect class="fig-repair" x="72" y="80" width="78" height="46" />
      <text class="fig-text" x="150" y="12" text-anchor="middle">AFTER REVISION →</text>
      <text class="fig-text" x="111" y="27" text-anchor="middle">RIGHT</text>
      <text class="fig-text" x="189" y="27" text-anchor="middle">WRONG</text>
      <text class="fig-text" x="64" y="27" text-anchor="end">DRAFT ↓</text>
      <text class="fig-text" x="64" y="59" text-anchor="end">RIGHT</text>
      <text class="fig-text" x="64" y="105" text-anchor="end">WRONG</text>
      <text class="fig-text fig-text--strong" x="111" y="59" text-anchor="middle">PRESERVED</text>
      <text class="fig-text fig-text--strong" x="189" y="59" text-anchor="middle">HARMED</text>
      <text class="fig-text fig-text--strong" x="111" y="105" text-anchor="middle">REPAIRED</text>
      <text class="fig-text" x="189" y="105" text-anchor="middle">UNRECOVERED</text>
      <text class="fig-accent-text fig-sign" x="111" y="118" text-anchor="middle">+1</text>
      <text class="fig-harm-text fig-sign" x="189" y="72" text-anchor="middle">−1</text>
      <text class="fig-text" x="150" y="142" text-anchor="middle">BOTH BRANCHES, SAME QUESTION</text>
    </svg>
  )}

  {kind === 'threshold' && (
    <svg viewBox="0 0 240 150" role="img" aria-labelledby={titleId}>
      <title id={titleId}>
        Dot columns of predictions by confidence, cut by a vertical threshold: hollow dots on the left
        are declined, filled dots on the right are answered.
      </title>
      <g class="fig-ink">
        {dots.map((d) =>
          d.below ? (
            <circle class="fig-hollow" cx={d.x} cy={d.y} r="2.3" />
          ) : (
            <circle class="fig-solid" cx={d.x} cy={d.y} r="2.4" />
          ),
        )}
        <path class="fig-axis" d="M12 134.5H228" />
        <path class="fig-axis" d="M12 131v7M228 131v7" />
      </g>
      <path class="fig-accent" d={`M${tauX} 22V140`} />
      <text class="fig-accent-text" x={tauX + 5} y="30">τ</text>
      <text class="fig-text" x="12" y="148">0</text>
      <text class="fig-text" x="228" y="148" text-anchor="end">1</text>
      <text class="fig-text" x={tauX - 6} y="30" text-anchor="end">DECLINE</text>
      <text class="fig-text" x="228" y="30" text-anchor="end">ANSWER</text>
      <text class="fig-text" x="120" y="148" text-anchor="middle">CONFIDENCE</text>
    </svg>
  )}

  {kind === 'imagery' && (
    <svg viewBox="0 0 240 150" role="img" aria-labelledby={titleId}>
      <title id={titleId}>
        An image and a swapped counterpart feed the same model; the figure asks how much the output
        changes.
      </title>
      <defs>
        <marker id={`${id}-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path class="fig-marker" d="M0 0.5L7.5 4L0 7.5" />
        </marker>
        <marker id={`${id}-arrow-a`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path class="fig-marker fig-marker--accent" d="M0 0.5L7.5 4L0 7.5" />
        </marker>
      </defs>
      <g class="fig-ink">
        <rect class="fig-dashed" x="28" y="34" width="56" height="56" />
        <rect class="fig-box" x="18" y="46" width="56" height="56" />
        <path class="fig-line" d="M24 94l14-16 9 9 7-7 14 14" />
        <circle class="fig-line" cx="58" cy="62" r="5" />
        <path class="fig-line" d="M92 74H124" marker-end={`url(#${id}-arrow)`} />
        <rect class="fig-box" x="130" y="54" width="54" height="40" />
        <path class="fig-line" d="M184 74H206" marker-end={`url(#${id}-arrow)`} />
      </g>
      <path
        class="fig-accent"
        d="M92 58c8-10 22-10 30 0"
        marker-end={`url(#${id}-arrow-a)`}
        marker-start={`url(#${id}-arrow-a)`}
      />
      <text class="fig-text" x="157" y="77" text-anchor="middle">MODEL</text>
      <text class="fig-accent-text fig-big" x="222" y="80" text-anchor="middle">Δ</text>
      <text class="fig-text" x="18" y="118">IMAGE</text>
      <text class="fig-text" x="84" y="28" text-anchor="end">SWAPPED</text>
      <text class="fig-text" x="107" y="42" text-anchor="middle">⇄</text>
    </svg>
  )}

  <figcaption>
    {captions[kind]}
  </figcaption>
</figure>

<style>
  .work-fig {
    width: 100%;
    margin: 0;
    color: var(--color-text-soft);
  }

  .work-fig svg {
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }

  .work-fig figcaption {
    max-width: 26rem;
    margin: 1rem auto 0;
    color: var(--color-text-soft);
    font: 500 0.625rem / 1.5 var(--font-mono);
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Keep Greek symbols lowercase: an uppercased δ reads as Δ. */
  .work-fig__sym {
    text-transform: none;
  }

  .fig-line,
  .fig-axis,
  .fig-dashed,
  .fig-box,
  .fig-hollow {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .fig-axis {
    opacity: 0.7;
  }

  .fig-dashed {
    stroke-dasharray: 3 3;
    opacity: 0.75;
  }

  .fig-box {
    fill: var(--color-bg);
    stroke: var(--color-text-muted);
  }

  .fig-line {
    stroke: var(--color-text-muted);
  }

  .fig-solid {
    fill: var(--color-text);
  }

  .fig-hollow--strong {
    fill: var(--color-bg-alt);
    stroke: var(--color-text);
    stroke-width: 1.2;
  }

  .fig-marker {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.2;
  }

  .fig-marker--accent {
    stroke: var(--color-accent);
  }

  .fig-accent {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .fig-accent-fill {
    fill: var(--color-accent);
  }

  /* Repaired and harmed: the two cells that move accuracy. Identity is also in
     the words and the +1 / −1 signs, never color alone. */
  .fig-repair,
  .fig-harm {
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .fig-repair {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
  }

  .fig-harm {
    fill: var(--color-secondary-soft);
    stroke: var(--color-secondary);
  }

  .fig-text,
  .fig-accent-text,
  .fig-harm-text {
    fill: currentColor;
    font: 500 6.5px var(--font-mono);
    letter-spacing: 0.06em;
  }

  .fig-text--strong {
    fill: var(--color-text);
  }

  .fig-accent-text {
    fill: var(--color-accent);
    font-size: 10px;
  }

  .fig-harm-text {
    fill: var(--color-secondary);
    font-size: 10px;
  }

  .fig-sign {
    font-size: 8px;
    font-weight: 600;
  }

  .fig-big {
    font: 500 15px var(--font-sans);
  }
</style>
