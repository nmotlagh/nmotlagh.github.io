---
import type { SkillGroup } from "../../data/editorial";

interface Props {
  facts: string[];
  skillGroups: SkillGroup[];
  resumeHref: string;
  emailHref: string;
  linkedInHref: string;
  githubHref: string;
  scholarHref: string;
  orcidHref?: string;
}

const {
  facts,
  skillGroups,
  resumeHref,
  emailHref,
  linkedInHref,
  githubHref,
  scholarHref,
  orcidHref,
}: Props = Astro.props;
const emailAddress = emailHref.replace(/^mailto:/, "");
---

<section class="contact-rail surface surface--raised" aria-labelledby="contact-title">
  <div class="contact-rail__intro">
    <p class="eyebrow">Work with me</p>
    <h2 id="contact-title">Research Scientist, Applied Scientist, and ML Engineer roles.</h2>
    <p>
      Best fit: teams working on LLM evaluation, calibration, retrieval-augmented
      systems, or reliability infrastructure. I design the experiments, write the
      training and evaluation code, and run them at cluster scale.
    </p>

    <div class="contact-rail__actions">
      <a class="button" href={emailHref}>Email me</a>
      <a class="button button--ghost" href={resumeHref} target="_blank" rel="noopener noreferrer">
        View resume
      </a>
    </div>

    <p class="contact-rail__email">
      <span>Email</span>
      <a href={emailHref}>{emailAddress}</a>
    </p>

    <div class="contact-rail__links">
      <a href={linkedInHref} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={githubHref} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={scholarHref} target="_blank" rel="noopener noreferrer">Scholar</a>
      {orcidHref && <a href={orcidHref} target="_blank" rel="noopener noreferrer">ORCID</a>}
    </div>
  </div>

  <div class="contact-rail__details">
    <div class="contact-rail__panel">
      <p class="eyebrow">At a glance</p>
      <ul class="contact-rail__facts">
        {facts.map((fact) => (
          <li>{fact}</li>
        ))}
      </ul>
    </div>

    <div class="contact-rail__panel">
      <p class="eyebrow">Toolkit</p>
      <dl class="contact-rail__toolkit">
        {skillGroups.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>{group.items.join(" · ")}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .contact-rail {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(1.55rem, 3.2vw, 2.6rem);
    overflow: hidden;
  }

  .contact-rail::before {
    content: '';
    position: absolute;
    inset: auto -10% -40% 40%;
    height: 70%;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--color-accent) 12%, transparent),
      transparent 68%
    );
  }

  .contact-rail > * {
    position: relative;
  }

  @media (min-width: 960px) {
    .contact-rail {
      grid-template-columns: minmax(0, 1.15fr) minmax(21rem, 0.95fr);
      align-items: start;
    }
  }

  .contact-rail__intro h2 {
    margin: 0.5rem 0 0;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: var(--display-2, clamp(2.2rem, 1.7rem + 2.1vw, 3.2rem));
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .contact-rail__intro p:not([class]) {
    margin: 1rem 0 0;
    max-width: 36rem;
    color: var(--color-text-muted);
    font-size: var(--text-md, 1rem);
    line-height: 1.65;
  }

  .contact-rail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .contact-rail__email {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 1.15rem 0 0;
  }

  .contact-rail__email span {
    color: var(--color-text-soft);
    font: 600 var(--label-sm, 0.6875rem) / 1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-rail__email a {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm, 0.9375rem);
    overflow-wrap: anywhere;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    text-underline-offset: 0.18em;
  }

  .contact-rail__email a:hover,
  .contact-rail__email a:focus-visible {
    color: var(--color-accent);
  }

  .contact-rail__details {
    display: grid;
    gap: 1.35rem;
  }

  .contact-rail__panel {
    padding: 1.15rem 0 0;
    border-top: var(--hairline-strong);
  }

  .contact-rail__facts {
    display: grid;
    gap: 0.6rem;
    margin: 0.8rem 0 0;
    padding-left: 1.05rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm, 0.9375rem);
    line-height: 1.65;
  }

  .contact-rail__toolkit {
    display: grid;
    gap: 0.75rem;
    margin: 0.8rem 0 0;
  }

  .contact-rail__toolkit dt {
    color: var(--color-text-soft);
    font: 600 var(--label-sm, 0.6875rem) / 1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-rail__toolkit dd {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm, 0.9375rem);
    line-height: 1.6;
  }

  .contact-rail__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: var(--hairline);
  }

  .contact-rail__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .contact-rail__links a:hover,
  .contact-rail__links a:focus-visible {
    color: var(--color-accent);
  }
</style>
