---
import { skillGroups } from '../../data/editorial';
import { links, person } from '../../data/site';
const resumeHref = `${import.meta.env.BASE_URL}resume.pdf`;
---

<section class="contact-rail" aria-labelledby="contact-title">
  <div>
    <p class="eyebrow">Get in touch</p>
    <h2 id="contact-title">Let’s build reliable ML systems.</h2>
    <p class="contact-rail__intro">
      I’m exploring research engineering, ML software engineering, and applied
      scientist roles in {person.targetLocations.join(' and ')}.
    </p>
    <div class="contact-rail__actions">
      <a class="button" href={links.email}>Email me</a>
      <a class="button button--ghost" href={resumeHref} target="_blank" rel="noopener noreferrer">Resume (PDF)</a>
    </div>
  </div>
  <dl class="contact-rail__toolkit">
    {skillGroups.map((group) => (
      <div><dt>{group.label}</dt><dd>{group.items.join(' · ')}</dd></div>
    ))}
  </dl>
</section>

<style>
  .contact-rail {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1.75rem, 4vw, 3rem);
    border-top: var(--hairline-strong);
  }
  .contact-rail h2 {
    max-width: 23ch;
    margin: 0.5rem 0 0;
    font: 400 var(--display-2) / 1.05 var(--font-display);
  }
  .contact-rail__intro {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
  }
  .contact-rail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .contact-rail__toolkit {
    display: grid;
    gap: 1.2rem;
    align-content: start;
    margin: 0;
  }
  .contact-rail__toolkit dt {
    color: var(--color-text-soft);
    font: 600 0.7rem / 1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .contact-rail__toolkit dd {
    margin: 0.4rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  @media (min-width: 900px) {
    .contact-rail {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
