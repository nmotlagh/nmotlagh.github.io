---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../utils/dates';

interface Props {
  newsItems: CollectionEntry<'news'>[];
}

const { newsItems }: Props = Astro.props;
const dateFormat = {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
} satisfies Intl.DateTimeFormatOptions;
const newsHref = `${import.meta.env.BASE_URL}news/`;
const isExternalHref = (href: string) => /^https?:\/\//.test(href);
---

<section class="dispatch-list">
  <article class="dispatch-list__panel surface">
    <div class="dispatch-list__header">
      <div>
        <p class="eyebrow">News</p>
        <h2>Latest news</h2>
      </div>
      <a href={newsHref}>View archive</a>
    </div>

    <ol class="dispatch-list__items">
      {newsItems.map((item) => (
        <li>
          <time datetime={item.data.date}>{formatDate(item.data.date, dateFormat)}</time>
          {item.data.link ? (
            <a
              href={item.data.link}
              target={isExternalHref(item.data.link) ? "_blank" : undefined}
              rel={isExternalHref(item.data.link) ? "noopener noreferrer" : undefined}
            >
              {item.data.title}
            </a>
          ) : (
            <span>{item.data.title}</span>
          )}
        </li>
      ))}
    </ol>
  </article>
</section>

<style>
  .dispatch-list {
    display: grid;
    gap: 1rem;
  }

  .dispatch-list__panel {
    padding: clamp(1.2rem, 2.6vw, 1.6rem);
  }

  .dispatch-list__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .dispatch-list__header h2 {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: var(--display-3, clamp(1.75rem, 1.5rem + 1.1vw, 2.3rem));
    font-weight: 400;
    line-height: 1.02;
  }

  .dispatch-list__header > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-muted);
    font: 600 var(--label-sm, 0.6875rem) / 1.3 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .dispatch-list__header > a:hover,
  .dispatch-list__header > a:focus-visible {
    color: var(--color-accent);
  }

  .dispatch-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .dispatch-list__items li {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .dispatch-list__items li:first-child {
    padding-top: 0;
    border-top: none;
  }

  .dispatch-list__items time {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-text-soft);
    font: 700 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .dispatch-list__items a,
  .dispatch-list__items span {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .dispatch-list__items a {
    font-weight: 600;
  }

  .dispatch-list__items a:hover {
    color: var(--color-accent);
  }
</style>
