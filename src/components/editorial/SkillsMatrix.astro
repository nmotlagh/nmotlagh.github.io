---
import type { SkillGroup } from "../../data/editorial";

interface Props {
  groups: SkillGroup[];
}

const { groups }: Props = Astro.props;
---

<section class="skills-matrix surface" aria-label="Technical toolkit">
  <p class="eyebrow">Toolkit</p>
  <div class="skills-matrix__grid">
    {groups.map((group) => (
      <div class="skills-matrix__group">
        <p class="skills-matrix__label">{group.label}</p>
        <ul class="skills-matrix__chips" role="list">
          {group.items.map((item) => (
            <li class="tag">{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-matrix {
    position: relative;
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    overflow: hidden;
  }

  .skills-matrix::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.26rem;
    background: var(--color-positive);
    opacity: 0.82;
  }

  .skills-matrix__grid {
    display: grid;
    gap: 1.2rem 2rem;
  }

  @media (min-width: 760px) {
    .skills-matrix__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .skills-matrix__group {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .skills-matrix__label {
    margin: 0;
    color: var(--color-text-soft);
    font: 600 0.72rem/1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .skills-matrix__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
