---
import type { ResearchResult } from '../../data/editorial';

interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  results: ResearchResult[];
}
const { eyebrow, title, summary, results }: Props = Astro.props;
---

<section class="research" aria-labelledby="research-title">
  <header>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="research-title">{title}</h2>
    <p class="research__summary">{summary}</p>
  </header>
  <ol class="research__list">
    {results.map((result) => (
      <li class="research__item">
        <span class="research__index" aria-hidden="true">{result.index}</span>
        <p class="research__venue">{result.venue}</p>
        <h3>{result.title}</h3>
        <p class="research__question">{result.summary}</p>
        <p class="research__contribution">{result.contribution}</p>
        <a href={`${import.meta.env.BASE_URL}publications/${result.publicationSlug}/`}>
          {result.linkLabel}<span aria-hidden="true"> ↗</span>
          <span class="sr-only">: {result.title}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .research h2 {
    margin: 0.5rem 0 0;
    font: 400 var(--display-2) / 1.05 var(--font-display);
  }
  .research__summary {
    max-width: 40rem;
    margin: 0.85rem 0 0;
    color: var(--color-text-muted);
  }
  .research__list {
    display: grid;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border-block: var(--hairline-strong);
  }
  .research__item {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.75rem 0;
  }
  .research__item + .research__item { border-top: var(--hairline); }
  .research__index {
    color: var(--color-accent);
    font: 400 2rem / 1 var(--font-display);
  }
  .research__venue {
    margin: 1.4rem 0 0.6rem;
    color: var(--color-text-soft);
    font: 600 0.7rem / 1.5 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .research__item h3 {
    margin: 0;
    font: 400 1.85rem / 1.1 var(--font-display);
  }
  .research__question { margin: 1rem 0 0; }
  .research__contribution {
    margin: 0.65rem 0 1.1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .research__item a {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.3rem;
    min-height: 44px;
    margin-top: auto;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  @media (min-width: 900px) {
    .research__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .research__item { padding: 1.8rem 1.8rem 1.2rem; }
    .research__item:first-child { padding-left: 0; }
    .research__item:last-child { padding-right: 0; }
    .research__item + .research__item {
      border-top: 0;
      border-left: var(--hairline);
    }
  }
</style>
