---
import { Image } from 'astro:assets';
import headshot from '../../assets/headshot.jpg';
import { links, person } from '../../data/site';

interface Props {
  eyebrow: string;
  title: string;
  ledeHtml: string;
  supporting: string;
  resumeHref: string;
  paperCount: number;
}
const { eyebrow, title, ledeHtml, supporting, resumeHref, paperCount }: Props = Astro.props;
const profileLinks = [
  { label: 'GitHub', href: links.github },
  { label: 'Scholar', href: links.scholar },
  { label: 'LinkedIn', href: links.linkedin },
];
---

<div class="editorial-hero">
  <div class="editorial-hero__copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="editorial-hero__title">{title}</h1>
    <p class="editorial-hero__lede" set:html={ledeHtml} />
    <p class="editorial-hero__supporting">{supporting}</p>
    <div class="editorial-hero__actions">
      <a class="button" href={resumeHref} target="_blank" rel="noopener noreferrer">Resume (PDF)</a>
      <a class="button button--ghost" href={links.email}>Get in touch</a>
    </div>
    <p class="editorial-hero__availability">
      <span aria-hidden="true"></span>{person.availability} · {person.targetLocations.join(' / ')}
    </p>
  </div>
  <div class="editorial-hero__visual">
    <figure class="editorial-hero__portrait">
      <Image
        src={headshot}
        alt="Nick Kashani Motlagh"
        width={600}
        height={720}
        widths={[240, 360, 600]}
        sizes="(max-width: 599px) 180px, (max-width: 959px) 240px, 320px"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <nav class="editorial-hero__links" aria-label="Profile links">
      {profileLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>
      ))}
    </nav>
  </div>
  <dl class="editorial-hero__facts">
    <div><dt>Education</dt><dd>PhD · Ohio State, 2026</dd></div>
    <div><dt>Publications</dt><dd>{paperCount} first-author papers</dd></div>
    <div><dt>Recognition</dt><dd>Best Paper · ISVC 2022</dd></div>
  </dl>
</div>

<style>
  .editorial-hero {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1rem, 3vw, 2.5rem);
  }
  .editorial-hero__copy { min-width: 0; }
  .editorial-hero__title {
    max-width: 14ch;
    margin: 1.2rem 0 0;
    font: 400 var(--display-1) / 0.98 var(--font-display);
    letter-spacing: -0.025em;
  }
  .editorial-hero__lede {
    max-width: 26ch;
    margin: 1.5rem 0 0;
    font: 400 clamp(1.7rem, 1.1rem + 1.8vw, 2.65rem) / 1.12 var(--font-display);
  }
  .editorial-hero__lede :global(em) { color: var(--color-accent); }
  .editorial-hero__supporting {
    max-width: 35rem;
    margin: 1.2rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
  .editorial-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .editorial-hero__availability {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin: 1.2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .editorial-hero__availability > span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-positive);
  }
  .editorial-hero__visual {
    width: min(100%, 20rem);
    min-width: 0;
    align-self: center;
  }
  .editorial-hero__portrait {
    margin: 0;
    background: var(--color-panel-strong);
    border: var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .editorial-hero__portrait :global(img) {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    object-position: center 25%;
  }
  .editorial-hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }
  .editorial-hero__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    min-height: 44px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  .editorial-hero__facts {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
    margin: 0.5rem 0 0;
    padding: 1.4rem 0;
    border-block: var(--hairline);
  }
  .editorial-hero__facts dt {
    color: var(--color-text-soft);
    font: 600 0.68rem / 1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .editorial-hero__facts dd {
    margin: 0.4rem 0 0;
    font-size: var(--text-md);
  }
  @media (min-width: 600px) {
    .editorial-hero__facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 960px) {
    .editorial-hero {
      grid-template-columns: minmax(0, 1fr) 20rem;
      column-gap: clamp(3rem, 8vw, 8rem);
    }
  }
  @media (min-width: 600px) and (max-width: 959px) {
    .editorial-hero { grid-template-columns: minmax(0, 1fr) 15rem; }
    .editorial-hero__title { font-size: clamp(3rem, 6vw, 4.5rem); }
  }
  @media (max-width: 599px) {
    .editorial-hero__visual {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      width: 100%;
    }
    .editorial-hero__portrait {
      width: 9rem;
      flex: 0 0 9rem;
    }
    .editorial-hero__links {
      flex-direction: column;
      gap: 0.1rem;
      margin: 0;
    }
    .editorial-hero__facts > div {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      align-items: baseline;
      gap: 0.75rem;
    }
    .editorial-hero__facts dd {
      margin: 0;
      font-size: 0.9rem;
    }
  }
</style>
