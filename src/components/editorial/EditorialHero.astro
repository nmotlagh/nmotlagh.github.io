---
import MeadowScene from './MeadowScene.astro';
import demo from '../../data/abstain-demo.json';
import { links, person } from '../../data/site';

interface Props {
  eyebrow: string;
  title: string;
  ledeHtml: string;
  supporting: string;
  resumeHref: string;
  terminal: { command: string; href: string };
}
const { eyebrow, title, ledeHtml, supporting, resumeHref, terminal }: Props = Astro.props;

const sampleCount = new Intl.NumberFormat('en-US').format(demo.sample.score.length);
// Wrap the command only after a path segment ("github.com/", "osu-cvl/"), never
// at the hyphen in "osu-cvl" or inside "https://".
const commandParts = terminal.command.split(/(?<=[a-z]\/)/);
---

<section class="hero" id="about" aria-labelledby="hero-title">
  <MeadowScene />

  <div class="site-shell hero__body">
    <p class="label hero__eyebrow"><span class="label__index">01</span>{eyebrow}</p>
    <h1 class="hero__title" id="hero-title">
      <span class="hero__name">{title}.</span>
      <span class="hero__claim" set:html={ledeHtml} />
    </h1>
    <div class="hero__detail">
      <p class="hero__lede">{supporting}</p>
      <div class="hero__cta">
        <a class="button" href={resumeHref} target="_blank" rel="noopener noreferrer">Resume (PDF)</a>
        <a class="button button--ghost" href={links.email}>Get in touch</a>
        <a class="hero__terminal" href={terminal.href} target="_blank" rel="noopener noreferrer">
          <span class="hero__prompt" aria-hidden="true">$</span>
          {/* One line: whitespace between the segments would render as spaces. */}
          <code>{commandParts.map((part, i) => <Fragment>{i > 0 && <wbr />}<span class="hero__seg">{part}</span></Fragment>)}</code>
          <span class="hero__cursor" aria-hidden="true"></span>
          <span class="sr-only">(opens the repository on GitHub)</span>
        </a>
      </div>
    </div>

    <p class="hero__fig">
      <span class="hero__fig-label">FIG.0</span>
      <span class="hero__fig-text">
        {sampleCount} CIFAR-100 test predictions, grown to their confidence. Below the line, the
        model says “I don’t know.”
      </span>
      <a href="#demo">Try the threshold <span aria-hidden="true">↓</span></a>
    </p>
  </div>

  <div class="hero__strip">
    <div class="site-shell hero__strip-inner">
      {/* The recruiter line: status and roles, then where and work authorization. */}
      <p class="hero__availability">
        <span class="hero__dot" aria-hidden="true"></span>
        {/* One line, so the only spaces are the ones inside the separators (the wrap points). */}
        <span><span class="hero__status">{person.availability}</span><span class="hero__slash" aria-hidden="true"> · </span><span class="sr-only">for </span>{person.seekingShort.map((role, i) => <Fragment>{i > 0 && <span class="sr-only">,</span>}{i > 0 && <span class="hero__slash" aria-hidden="true"> / </span>}<span class="hero__role">{role}</span></Fragment>)}</span>
      </p>
      <p class="hero__credentials">
        <span>{person.targetLocationsShort.join(' / ')}<span class="sr-only">.</span><span class="hero__slash" aria-hidden="true"> · </span>{person.citizenship}</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* The copy starts just below the scene's horizon (the glowing threshold line).
     --hero-hz mirrors the horizon in MeadowScene / layoutFor (src/lib/meadow-look.ts)
     as a percentage of the hero height, rounded up within each aspect band so the
     text never rides the line. The hero is one viewport tall, so 1svh = 1% of it. */
  .hero {
    --hero-hz: 38;
    --hero-gap: 30px;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-bg);
  }

  @media (max-aspect-ratio: 5 / 4) {
    .hero {
      --hero-hz: 37.5;
    }
  }

  @media (max-aspect-ratio: 1 / 1) {
    .hero {
      --hero-hz: 34.5;
    }
  }

  @media (max-aspect-ratio: 3 / 4) {
    .hero {
      --hero-hz: 31;
    }
  }

  .hero__body {
    position: relative;
    z-index: 1;
    flex: 1 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    padding-top: calc(var(--hero-hz) * 1vh + var(--hero-gap));
    padding-top: calc(var(--hero-hz) * 1svh + var(--hero-gap));
    padding-bottom: clamp(1.25rem, 0.5rem + 2.5vh, 2.25rem);
    pointer-events: none;
  }

  .hero__body > * {
    pointer-events: auto;
  }

  .hero__eyebrow {
    margin-bottom: 1rem;
  }

  .hero__title {
    margin: 0;
    font: 500 clamp(2.1rem, 0.85rem + 3.3vw, 3.9rem) / 1.02 var(--font-display);
    letter-spacing: -0.042em;
    text-wrap: balance;
  }

  .hero__name {
    color: var(--color-text);
  }

  .hero__claim {
    color: var(--color-text-soft);
  }

  .hero__claim :global(em) {
    font-style: normal;
  }

  .hero__detail {
    min-width: 0;
    margin-top: clamp(1rem, 0.5rem + 1.5vh, 1.5rem);
  }

  .hero__lede {
    max-width: 40rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: clamp(1.1rem, 0.5rem + 1.8vh, 1.75rem);
  }

  /* Terminal: a hairline chip with a prompt and a blinking block cursor. */
  .hero__terminal {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 100%;
    min-height: 2.5rem;
    padding: 0.45rem 0.85rem;
    border: var(--hairline-strong);
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    color: var(--color-text);
    font: 400 0.82rem / 1.35 var(--font-mono);
    text-decoration: none;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: border-color var(--transition-fast);
  }

  .hero__terminal:hover,
  .hero__terminal:focus-visible {
    border-color: var(--color-text-soft);
    color: var(--color-text);
  }

  .hero__terminal code {
    min-width: 0;
    font: inherit;
    overflow-wrap: anywhere;
  }

  .hero__seg {
    white-space: nowrap;
  }

  .hero__prompt {
    color: var(--color-accent);
    font-weight: 600;
  }

  .hero__cursor {
    flex: none;
    width: 0.55em;
    height: 1.15em;
    margin-left: -0.35rem;
    background: var(--color-text);
    animation: hero-blink 1.1s steps(1, end) infinite;
  }

  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cursor {
      animation: none;
    }
  }

  /* FIG.0 caption for the scene. */
  .hero__fig {
    max-width: 19rem;
    margin: 0;
    color: var(--color-text-soft);
    font: 400 0.75rem / 1.55 var(--font-mono);
    letter-spacing: 0.01em;
  }

  .hero__fig-label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-text);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .hero__fig-text {
    display: block;
  }

  .hero__fig a {
    display: flex;
    align-items: center;
    gap: 0.35em;
    width: fit-content;
    min-height: 2.75rem;
    color: var(--color-text);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hero__fig a:hover,
  .hero__fig a:focus-visible {
    color: var(--color-accent);
  }

  .hero__strip {
    position: relative;
    z-index: 1;
    border-top: var(--hairline);
    background: color-mix(in srgb, var(--color-bg) 62%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .hero__strip-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    min-height: 3.25rem;
    padding-block: 0.8rem;
    font: 500 var(--label-md) / 1.5 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero__strip-inner p {
    max-width: none;
    margin: 0;
  }

  .hero__availability {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.65rem;
    min-width: 0;
    color: var(--color-text-muted);
  }

  .hero__status {
    color: var(--color-text);
    white-space: nowrap;
  }

  .hero__role {
    white-space: nowrap;
  }

  .hero__dot {
    flex: none;
    margin-top: 0.52em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-positive);
    box-shadow: 0 0 0 3px var(--color-positive-soft);
  }

  .hero__credentials {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.65rem;
    color: var(--color-text);
  }

  .hero__slash {
    color: var(--color-text-faint);
    white-space: pre-wrap;
  }

  /* Desktop: the headline runs the full measure (two lines); the lede and
     calls to action sit under it, with the FIG.0 caption bottom right. */
  @media (min-width: 1000px) {
    .hero__body {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 19rem);
      grid-template-areas:
        'eyebrow eyebrow'
        'title title'
        'detail fig';
      column-gap: clamp(2rem, 4vw, 5rem);
    }

    .hero__eyebrow {
      grid-area: eyebrow;
    }

    .hero__title {
      grid-area: title;
      max-width: 22em;
    }

    .hero__detail {
      grid-area: detail;
    }

    .hero__fig {
      grid-area: fig;
      align-self: end;
      justify-self: end;
    }
  }

  /* Tablets and phones: the copy fills the field below the line, and the
     FIG.0 caption moves up into the sky, top left, like a panel's figure label. */
  @media (max-width: 999px) {
    .hero__fig {
      position: absolute;
      top: calc(var(--header-h) + 0.5rem);
      left: 0;
      width: min(100%, 17rem);
      max-width: none;
      padding-inline: var(--gutter);
      box-sizing: content-box;
      font-size: 0.6875rem;
      line-height: 1.5;
    }

    .hero__fig a {
      min-height: 2.75rem;
    }

    .hero__body {
      position: static;
    }

    .hero__body > :not(.hero__fig) {
      position: relative;
      z-index: 1;
    }

    .hero__fig {
      z-index: 1;
    }
  }

  @media (max-width: 640px) {
    .hero__body {
      padding-bottom: 1rem;
    }

    .hero__eyebrow {
      margin-bottom: 0.8rem;
      font-size: var(--label-sm);
      letter-spacing: 0.05em;
    }

    .hero__title {
      letter-spacing: -0.038em;
    }

    .hero__lede {
      font-size: var(--text-sm);
      line-height: 1.5;
    }

    .hero__cta .button {
      flex: 1 1 auto;
      min-height: 44px;
    }

    .hero__terminal {
      width: 100%;
      min-height: 44px;
      font-size: 0.74rem;
    }

    .hero__strip-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
      padding-block: 0.7rem;
      font-size: var(--label-sm);
    }
  }
</style>
