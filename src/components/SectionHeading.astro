---
interface Props {
  eyebrow?: string;
  /** Chapter number shown before the eyebrow, e.g. `2.1` or `03`. */
  index?: string;
  title: string;
  /** Trailing gray clause after the bright title (bright-then-gray headline). */
  dim?: string;
  description?: string;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  id?: string;
}

const { eyebrow, index, title, dim, description, as = 'h2', id } = Astro.props as Props;
const HeadingTag = as;
// Keep hyphenated compounds ("first-author") whole when a balanced heading wraps.
const dimParts = dim ? dim.split(/(\S+-\S+)/).filter(Boolean) : [];
---

<div class="section-heading">
  {(eyebrow || index) && (
    <p class="section-heading__eyebrow">
      {index && <span class="section-heading__index">{index}</span>}
      {eyebrow && <span>{eyebrow}</span>}
    </p>
  )}
  <HeadingTag class="section-heading__title" id={id}>
    {title}{dim && (
      <>
        {' '}
        <span class="section-heading__dim">
          {dimParts.map((part) => (/-/.test(part) && !/\s/.test(part) ? <span class="section-heading__keep">{part}</span> : part))}
        </span>
      </>
    )}
  </HeadingTag>
  {description && <p class="section-heading__description">{description}</p>}
</div>

<style>
  .section-heading__keep {
    white-space: nowrap;
  }
</style>
