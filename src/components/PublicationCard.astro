---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'publications'>;
  artifacts?: CollectionEntry<'artifacts'>[];
}

const { entry, artifacts = [] }: Props = Astro.props;
const { data, id } = entry;
const detailHref = `${import.meta.env.BASE_URL}publications/${id}/`;
const LEAD_AUTHOR = 'Kashani Motlagh';
const isLeadAuthor = (author: string) => author.includes(LEAD_AUTHOR);
const isFirstAuthor = isLeadAuthor(data.authors[0] ?? '');

// Prefer the authoritative published version (journal/proceedings) for the
// primary "Paper" link, and surface the preprint as a separate arXiv badge.
const primaryHref = data.external ?? data.pdf;
const badges = [
  primaryHref && { label: 'Paper', href: primaryHref },
  data.arxiv && data.arxiv !== primaryHref && { label: 'arXiv', href: data.arxiv },
  data.code && { label: 'Code', href: data.code },
  data.data && { label: 'Data', href: data.data },
  data.slides && { label: 'Slides', href: data.slides },
].filter(Boolean) as { label: string; href: string }[];
const isExternalHref = (href: string) => /^https?:\/\//.test(href);
---

<article class="publication-card surface">
  <div class="publication-card__meta">
    <p class="publication-card__eyebrow">{data.venue} / {data.year}</p>
    {isFirstAuthor && <span class="publication-card__role">First author</span>}
    {data.award && <span class="publication-card__award"><span aria-hidden="true">★</span> {data.award}</span>}
  </div>

  <h3 class="publication-card__title">
    <a href={detailHref}>
      {data.title}
    </a>
  </h3>
  <p class="publication-card__authors">
    {data.authors.map((author, index) => (
      <span class:list={['pub-author', isLeadAuthor(author) && 'pub-author--lead']}>
        {author}{index < data.authors.length - 1 ? ', ' : ''}
      </span>
    ))}
  </p>
  <p class="publication-card__tldr">{data.tldr}</p>

  {Array.isArray(data.tags) && data.tags.length > 0 && (
    <ul class="publication-card__tags" role="list">
      {data.tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  )}

  {data.highlights && data.highlights.length > 0 && (
    <ul class="publication-card__highlights">
      {data.highlights.slice(0, 2).map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )}

  {badges.some((badge) => Boolean(badge.href)) && (
    <div class="publication-card__links">
      {badges.map(
        (badge) =>
          badge.href && (
            <a
              class="badge badge--link"
              aria-label={`${badge.label} for ${data.title}`}
              href={badge.href}
              target={isExternalHref(badge.href) ? '_blank' : undefined}
              rel={isExternalHref(badge.href) ? 'noopener noreferrer' : undefined}
            >
              {badge.label}
            </a>
          ),
      )}
    </div>
  )}

  {artifacts.length > 0 && (
    <div class="publication-card__artifact-row">
      <span>Related code and data</span>
      <p>{artifacts.map((artifact) => artifact.data.name).join(' · ')}</p>
    </div>
  )}
</article>

<style>
  .publication-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: var(--pad-slab);
    transition: background-color var(--transition-fast);
  }

  .publication-card:hover,
  .publication-card:focus-within {
    background: var(--color-bg-alt);
  }

  .publication-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: center;
  }

  .publication-card__eyebrow {
    margin: 0;
    color: var(--color-text-soft);
    font: 500 var(--label-md) / 1.3 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .publication-card__title {
    margin: 0.25rem 0 0;
    font: 500 var(--display-3) / 1.15 var(--font-display);
    letter-spacing: -0.025em;
  }

  .publication-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .publication-card__title a:hover,
  .publication-card__title a:focus-visible {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .publication-card__authors {
    margin: 0;
    color: var(--color-text-soft);
    font: 400 var(--label-md) / 1.7 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .publication-card__authors .pub-author--lead {
    color: var(--color-text);
    font-weight: 500;
  }

  .publication-card__role {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.2rem 0.5rem;
    background: var(--color-tab);
    color: var(--color-text-muted);
    font: 500 0.625rem / 1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The award chip borrows the lime block: dark ink on lime in both themes. */
  .publication-card__award {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 1.5rem;
    padding: 0.2rem 0.55rem;
    background: var(--color-lime);
    color: var(--color-lime-ink);
    font: 500 0.625rem / 1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .publication-card__tldr {
    max-width: 44rem;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .publication-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .publication-card__highlights {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
  }

  .publication-card__highlights li {
    padding: 0.7rem 0;
    border-bottom: var(--hairline);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .publication-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .publication-card__artifact-row {
    padding-top: 0.9rem;
    border-top: var(--hairline);
  }

  .publication-card__artifact-row span {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--color-text-soft);
    font: 500 var(--label-sm) / 1.2 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .publication-card__artifact-row p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .publication-card {
      padding: var(--pad-card);
    }
  }
</style>
