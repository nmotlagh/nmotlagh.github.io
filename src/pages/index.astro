---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EditorialHero from "../components/editorial/EditorialHero.astro";
import ResearchResults from "../components/editorial/ResearchResults.astro";
import DispatchList from "../components/editorial/DispatchList.astro";
import ContactRail from "../components/editorial/ContactRail.astro";
import { homeEditorial, researchResults, skillGroups } from "../data/editorial";
import { person as personProfile } from "../data/site";
import {
  PERSON_ID,
  WEBSITE_ID,
  artifactNode,
  graph,
  personNode,
  publicationNode,
  websiteNode,
} from "../utils/schema";
import { parseDateValue } from "../utils/dates";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import headshot from "../assets/headshot.jpg";

const experience = await getEntry("pages", "experience");
const experienceItems = experience?.data.items ?? [];

const publicationEntries = await getCollection("publications", ({ data }) => !data.draft);
const isUnderReview = (entry: CollectionEntry<"publications">) =>
  entry.data.citation?.type === "unpublished";
// Peer-reviewed first, newest to oldest; anything still under review sorts to the
// bottom so the list leads with work that has actually cleared review.
const publications = publicationEntries.sort(
  (a, b) => Number(isUnderReview(a)) - Number(isUnderReview(b)) || b.data.year - a.data.year,
);
const artifactEntries = await getCollection("artifacts");
const artifactLookup = new Map(artifactEntries.map((entry) => [entry.id, entry]));

const featuredArtifacts = homeEditorial.featuredArtifactIds
  .map((id) => artifactLookup.get(id))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const newsItems = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => parseDateValue(b.data.date).getTime() - parseDateValue(a.data.date).getTime())
  .slice(0, 4);

const resumeHref = `${import.meta.env.BASE_URL}resume.pdf`;
const scholarHref = "https://scholar.google.com/citations?user=srZXFMcAAAAJ&hl=en";
const githubHref = "https://github.com/nmotlagh";
const linkedInHref = "https://www.linkedin.com/in/nicholas-kashani-motlagh";
const emailHref = "mailto:kashanimotlagh.1@osu.edu";
const orcidHref = "https://orcid.org/0000-0001-6229-6212";
const siteOrigin = Astro.site?.href ?? "https://nmotlagh.github.io/";
const headshotUrl = Astro.site ? new URL(headshot.src, Astro.site).href : headshot.src;
const personName = personProfile.name;

const stats = [
  { label: "First-author papers", value: "4 peer-reviewed" },
  { label: "Best paper", value: "ISVC 2022" },
  { label: "Largest study", value: "25,870 questions" },
  { label: "Available", value: "Now" },
];

const education = experience?.data.education ?? [];

/** One link row per paper, so the list reads evenly instead of raggedly. */
const publicationLinks = (entry: CollectionEntry<"publications">) =>
  [
    entry.data.pdf && { label: "PDF", href: entry.data.pdf },
    entry.data.doi && { label: "DOI", href: `https://doi.org/${entry.data.doi}` },
    !entry.data.pdf && !entry.data.doi && entry.data.external
      ? { label: "Paper", href: entry.data.external }
      : undefined,
    entry.data.arxiv && { label: "arXiv", href: entry.data.arxiv },
    entry.data.code && { label: "Code", href: entry.data.code },
    { label: "Cite", href: `${import.meta.env.BASE_URL}publications/${entry.slug}.bib` },
  ].filter(Boolean) as { label: string; href: string }[];

// One connected graph: the ProfilePage is *about* the Person, and every paper's
// author resolves to that same Person node rather than a bare name string.
const structuredData = graph([
  websiteNode(),
  {
    "@type": "ProfilePage",
    "@id": `${siteOrigin}#profile`,
    url: siteOrigin,
    name: `${personName} — ${homeEditorial.hero.eyebrow}`,
    isPartOf: { "@id": WEBSITE_ID },
    about: { "@id": PERSON_ID },
    mainEntity: { "@id": PERSON_ID },
    primaryImageOfPage: headshotUrl,
    inLanguage: "en-US",
  },
  personNode(education),
  ...publications.map(publicationNode),
  ...artifactEntries.map(artifactNode),
]);
---

<BaseLayout
  title="Home"
  description="Nick Kashani Motlagh — PhD in machine learning at Ohio State, working on when models should abstain, weigh evidence, or revise their answers."
  structuredData={structuredData}
>
  <section class="section section--hero" id="about">
    <div class="site-shell">
      <EditorialHero
        eyebrow={homeEditorial.hero.eyebrow}
        availability={homeEditorial.hero.availability}
        title={homeEditorial.hero.title}
        ledeHtml={homeEditorial.hero.ledeHtml}
        supporting={homeEditorial.hero.supporting}
        actions={[
          { label: "Resume (PDF)", href: resumeHref, external: true },
          { label: "Email me", href: emailHref, variant: "ghost" },
        ]}
        stats={stats}
        scholarHref={scholarHref}
        githubHref={githubHref}
        linkedInHref={linkedInHref}
        emailHref={emailHref}
      />
    </div>
  </section>

  <section class="section" id="research">
    <div class="site-shell">
      <ResearchResults
        eyebrow={homeEditorial.research.eyebrow}
        title={homeEditorial.research.title}
        subtitle={homeEditorial.research.subtitle}
        summary={homeEditorial.research.summary}
        meta={homeEditorial.research.meta}
        results={researchResults}
      />
    </div>
  </section>

  <section class="section" id="publications">
    <div class="site-shell stack">
      <SectionHeading
        eyebrow="Publications"
        title="Four peer-reviewed first-author papers."
      />

      <ol class="pub-list">
        {publications.map((entry) => (
          <li class="pub-list__item">
            <div class="pub-list__year">{entry.data.year}</div>
            <div class="pub-list__body">
              <h3 class="pub-list__title">
                <a href={`${import.meta.env.BASE_URL}publications/${entry.slug}/`}>
                  {entry.data.title}
                </a>
              </h3>
              <p class="pub-list__authors">
                {entry.data.authors.map((author, i) => (
                  <>
                    {i > 0 && ", "}
                    {author.includes("Kashani Motlagh") ? <strong>{author}</strong> : author}
                  </>
                ))}
              </p>
              <p class="pub-list__venue">
                <span>{entry.data.venue}</span>
                {entry.data.award && <span class="pub-list__award">{entry.data.award}</span>}
              </p>
            </div>
            <div class="pub-list__links">
              {publicationLinks(entry).map((link) => (
                <a
                  class="badge badge--link"
                  href={link.href}
                  aria-label={`${link.label} — ${entry.data.title}`}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="site-shell stack">
      <SectionHeading
        eyebrow="Experience"
        title="Five summers of AFRL-sponsored research, five years in the Computer Vision Lab."
      />

      <div class="home-experience-grid">
        {experienceItems.slice(0, 4).map((item) => (
          <article class="home-experience-card surface">
            <h3>{item.role}</h3>
            <p class="home-experience-card__meta">
              {item.location ? `${item.location} / ${item.timeframe}` : item.timeframe}
            </p>
            {item.bullets && item.bullets.length > 0 && (
              <ul>
                {item.bullets.slice(0, 2).map((bullet) => (
                  <li set:html={bullet} />
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>

      <div>
        <a class="button button--ghost" href={`${import.meta.env.BASE_URL}experience/`}>
          Full history
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="site-shell stack">
      <SectionHeading
        eyebrow="Code"
        title="Reject-option thresholds, calibration tooling, satellite collection."
      />

      <div class="home-artifact-grid">
        {featuredArtifacts.map((artifact) => (
          <article class="home-artifact-card surface">
            <h3>
              <a href={artifact.data.repo} target="_blank" rel="noopener noreferrer">
                {artifact.data.name}
              </a>
            </h3>
            <p>{artifact.data.summary}</p>
            {artifact.data.stack && artifact.data.stack.length > 0 && (
              <ul class="home-artifact-card__stack">
                {artifact.data.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>

      <div>
        <a class="button button--ghost" href={`${import.meta.env.BASE_URL}artifacts/`}>
          All code and data
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="news">
    <div class="site-shell">
      <DispatchList newsItems={newsItems} />
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <ContactRail
        facts={homeEditorial.recruiterFacts}
        skillGroups={skillGroups}
        resumeHref={resumeHref}
        emailHref={emailHref}
        linkedInHref={linkedInHref}
        githubHref={githubHref}
        scholarHref={scholarHref}
        orcidHref={orcidHref}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .pub-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline-strong);
  }

  .pub-list__item {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding: 1.35rem 0;
    border-bottom: var(--hairline);
  }

  @media (min-width: 800px) {
    .pub-list__item {
      grid-template-columns: 4rem minmax(0, 1fr) auto;
      align-items: baseline;
    }
  }

  .pub-list__year {
    color: var(--color-text-soft);
    font: 600 var(--label-sm, 0.6875rem) / 1.4 var(--font-mono);
    letter-spacing: 0.1em;
  }

  .pub-list__body {
    min-width: 0;
  }

  .pub-list__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .pub-list__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .pub-list__title a:hover,
  .pub-list__title a:focus-visible {
    color: var(--color-accent);
  }

  .pub-list__authors {
    margin: 0.35rem 0 0;
    max-width: 44rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm, 0.9375rem);
    line-height: 1.6;
  }

  .pub-list__authors strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .pub-list__venue {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.7rem;
    margin: 0.3rem 0 0;
    color: var(--color-text-soft);
    font-size: var(--text-sm, 0.9375rem);
    line-height: 1.5;
  }

  .pub-list__award {
    color: var(--color-secondary);
    font: 600 var(--label-sm, 0.6875rem) / 1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pub-list__award::before {
    content: '★';
    margin-right: 0.4em;
    letter-spacing: 0;
  }

  .pub-list__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
</style>
