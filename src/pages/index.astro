---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EditorialHero from "../components/editorial/EditorialHero.astro";
import ShortVersion from "../components/editorial/ShortVersion.astro";
import SelectedWork from "../components/editorial/SelectedWork.astro";
import AbstainDemo from "../components/editorial/AbstainDemo.astro";
import ContactRail from "../components/editorial/ContactRail.astro";
import { caseStudies, homeEditorial } from "../data/editorial";
import { person as personProfile } from "../data/site";
import {
  PERSON_ID,
  WEBSITE_ID,
  artifactNode,
  graph,
  personNode,
  publicationNode,
  websiteNode,
} from "../utils/schema";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import headshot from "../assets/headshot.jpg";

const experience = await getEntry("pages", "experience");
const experienceItems = experience?.data.items ?? [];

const publicationEntries = await getCollection("publications", ({ data }) => !data.draft);
const publications = publicationEntries
  .filter((entry) => entry.data.citation?.type !== "unpublished")
  .sort((a, b) => b.data.year - a.data.year);
// The award paper gets the lime block; the rest list beside it, newest first.
const awardPaper = publications.find((entry) => entry.data.award);
const otherPapers = publications.filter((entry) => entry !== awardPaper);
const publicationCount = publications.length;
const latestYear = publications[0]?.data.year;
const earliestYear = publications[publications.length - 1]?.data.year;
const artifactEntries = await getCollection("artifacts");
// FIG.0 is the hero scene; the case-study figures follow, then the demo.
const demoFig = caseStudies.length + 1;

const resumeHref = `${import.meta.env.BASE_URL}resume.pdf`;
const siteOrigin = Astro.site?.href ?? "https://nmotlagh.github.io/";
const headshotUrl = Astro.site ? new URL(headshot.src, Astro.site).href : headshot.src;
const personName = personProfile.name;

const education = experience?.data.education ?? [];

/** One link row per paper, so the list reads evenly instead of raggedly. */
const publicationLinks = (entry: CollectionEntry<"publications">) =>
  [
    entry.data.pdf && { label: "PDF", href: entry.data.pdf },
    entry.data.doi && { label: "DOI", href: `https://doi.org/${entry.data.doi}` },
    !entry.data.pdf && !entry.data.doi && entry.data.external
      ? { label: "Paper", href: entry.data.external }
      : undefined,
    entry.data.arxiv && { label: "arXiv", href: entry.data.arxiv },
    entry.data.code && { label: "Code", href: entry.data.code },
  ].filter(Boolean) as { label: string; href: string }[];

// One connected graph: the ProfilePage is *about* the Person, and every paper's
// author resolves to that same Person node rather than a bare name string.
const structuredData = graph([
  websiteNode(),
  {
    "@type": "ProfilePage",
    "@id": `${siteOrigin}#profile`,
    url: siteOrigin,
    name: `${personName} — ${homeEditorial.hero.eyebrow}`,
    isPartOf: { "@id": WEBSITE_ID },
    about: { "@id": PERSON_ID },
    mainEntity: { "@id": PERSON_ID },
    primaryImageOfPage: headshotUrl,
    inLanguage: "en-US",
  },
  personNode(education),
  ...publications.map(publicationNode),
  ...artifactEntries.map(artifactNode),
]);
---

<BaseLayout
  description={personProfile.description}
  structuredData={structuredData}
  overlayHeader
>
  <EditorialHero
    eyebrow={homeEditorial.hero.eyebrow}
    title={homeEditorial.hero.title}
    ledeHtml={homeEditorial.hero.ledeHtml}
    supporting={homeEditorial.hero.supporting}
    resumeHref={resumeHref}
    terminal={homeEditorial.hero.terminal}
  />

  <section class="section section--brief" id="short-version">
    <div class="site-shell">
      <ShortVersion />
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="site-shell">
      <SelectedWork index="2.1" firstFig={1} />
    </div>
  </section>

  <section class="section" id="demo">
    <div class="site-shell">
      <AbstainDemo index="2.2" fig={demoFig} />
    </div>
  </section>

  <section class="section" id="research">
    <div class="site-shell">
      <SectionHeading
        index="03"
        eyebrow="Research"
        title="Peer-reviewed publications."
        dim={`${publicationCount}\u00a0first-author papers, ${earliestYear}–${latestYear}.`}
      />

      <div class="pubs">
        {awardPaper && (
          <article class="pubs__award">
            <p class="pubs__award-label">
              <span aria-hidden="true">★</span> {awardPaper.data.award} · {awardPaper.data.venue}
            </p>
            <h3 class="pubs__award-title">
              <a href={`${import.meta.env.BASE_URL}publications/${awardPaper.slug}/`}>
                {awardPaper.data.title}
              </a>
            </h3>
            <p class="pubs__award-tldr">{awardPaper.data.tldr}</p>
            <p class="pubs__award-authors">
              {awardPaper.data.authors.map((author, i) => (
                <>
                  {i > 0 && ", "}
                  {author.includes("Kashani Motlagh") ? <strong>{author}</strong> : author}
                </>
              ))}
            </p>
            <div class="pubs__award-links">
              {publicationLinks(awardPaper).map((link) => (
                <a
                  class="pubs__award-link"
                  href={link.href}
                  aria-label={`${link.label} — ${awardPaper.data.title}`}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                >
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </article>
        )}

        <ol class="pub-list">
          {otherPapers.map((entry) => (
            <li class="pub-list__item">
              <p class="pub-list__meta">
                <span class="pub-list__year">{entry.data.year}</span>
                <span>{entry.data.venue}</span>
              </p>
              <h3 class="pub-list__title">
                <a href={`${import.meta.env.BASE_URL}publications/${entry.slug}/`}>
                  {entry.data.title}
                </a>
              </h3>
              <p class="pub-list__authors">
                {entry.data.authors.map((author, i) => (
                  <>
                    {i > 0 && ", "}
                    {author.includes("Kashani Motlagh") ? <strong>{author}</strong> : author}
                  </>
                ))}
              </p>
              <div class="pub-list__links">
                {publicationLinks(entry).map((link) => (
                  <a
                    class="badge badge--link"
                    href={link.href}
                    aria-label={`${link.label} — ${entry.data.title}`}
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="section-more">
        <a class="button button--ghost" href={`${import.meta.env.BASE_URL}publications/`}>
          All research
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="site-shell">
      <SectionHeading
        index="04"
        eyebrow="Experience"
        title="AFRL-sponsored ML research every year since 2020."
        dim="DCS Corp since May 2025; Ohio State’s Computer Vision Lab, 2021–2026."
      />

      <div class="home-experience-grid">
        {experienceItems.slice(0, 2).map((item, i) => (
          <article class="home-experience-card">
            <p class="home-experience-card__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
            <div class="home-experience-card__body">
              <h3>{item.role}</h3>
              <p class="home-experience-card__meta">
                {item.location ? `${item.location} / ${item.timeframe}` : item.timeframe}
              </p>
              {item.bullets && item.bullets.length > 0 && (
                <ol>
                  {item.bullets.slice(0, 4).map((bullet, j) => (
                    <li>
                      <span class="home-experience-card__num" aria-hidden="true">{i + 1}.{j + 1}</span>
                      <span set:html={bullet} />
                    </li>
                  ))}
                </ol>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="section-more">
        <a class="button button--ghost" href={`${import.meta.env.BASE_URL}experience/`}>
          Full history
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="site-shell">
      <ContactRail index="05" fig={demoFig + 1} />
    </div>
  </section>
</BaseLayout>

<style>
  /* The recruiter panel sits close under the hero strip. */
  .section--brief {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .pubs {
    display: grid;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    border: var(--hairline);
  }

  /* The one lime block: the award paper, always dark ink on lime. */
  .pubs__award {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--pad-slab);
    background: var(--color-lime);
    color: var(--color-lime-ink);
  }

  .pubs__award-label {
    margin: 0;
    color: var(--color-lime-ink);
    font: 500 var(--label-md) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pubs__award-title {
    margin: clamp(1.5rem, 1rem + 3vw, 4rem) 0 0;
    font: 500 var(--display-2) / 1.06 var(--font-display);
    letter-spacing: var(--tracking-display);
  }

  .pubs__award-title a {
    color: inherit;
    text-decoration: none;
  }

  .pubs__award-title a:hover,
  .pubs__award-title a:focus-visible {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-lime-line);
    text-decoration-thickness: 2px;
  }

  .pubs__award-title a:focus-visible,
  .pubs__award-link:focus-visible {
    outline-color: var(--color-lime-ink);
  }

  .pubs__award-tldr {
    max-width: 34rem;
    margin: 1.1rem 0 0;
    color: var(--color-lime-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .pubs__award-authors {
    margin: auto 0 0;
    padding-top: 2rem;
    color: var(--color-lime-muted);
    font: 400 var(--label-md) / 1.5 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .pubs__award-authors strong {
    color: var(--color-lime-ink);
    font-weight: 600;
  }

  .pubs__award-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-lime-line);
  }

  .pubs__award-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 1.875rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-lime-line);
    color: var(--color-lime-ink);
    font: 500 0.6875rem / 1.2 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .pubs__award-link:hover,
  .pubs__award-link:focus-visible {
    background: var(--color-lime-line);
    color: var(--color-lime-ink);
  }

  .pub-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pub-list__item {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: var(--pad-card);
  }

  .pub-list__item + .pub-list__item {
    border-top: var(--hairline);
  }

  .pub-list__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    color: var(--color-text-soft);
    font: 500 var(--label-sm) / 1.5 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pub-list__year {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .pub-list__title {
    margin: 0.2rem 0 0;
    font: 500 1.125rem / 1.3 var(--font-display);
    letter-spacing: -0.015em;
  }

  .pub-list__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .pub-list__title a:hover,
  .pub-list__title a:focus-visible {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .pub-list__authors {
    margin: 0;
    max-width: 44rem;
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .pub-list__authors strong {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .pub-list__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  @media (min-width: 1000px) {
    .pubs {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .pub-list {
      border-left: var(--hairline);
    }
  }

  @media (max-width: 999px) {
    .pub-list {
      border-top: var(--hairline);
    }
  }

  @media (max-width: 640px) {
    .pubs__award-link {
      min-height: 44px;
    }
  }
</style>
