---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { formatDate, parseDateValue } from '../../utils/dates';

const newsItems = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => parseDateValue(b.data.date).getTime() - parseDateValue(a.data.date).getTime(),
);
const dateFormat = { month: 'long', day: 'numeric', year: 'numeric' } satisfies Intl.DateTimeFormatOptions;
const isExternalHref = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout title="News" description="Latest publications, releases, and results across selective prediction and multimodal ML.">
  <section class="section">
    <div class="site-shell archive-page">
      <div class="archive-page__header">
        <div>
          <SectionHeading
            as="h1"
            eyebrow="Updates"
            title="News"
          />
        </div>

        <p class="archive-page__aside">
          Also available via RSS.
        </p>
      </div>

      <ol class="news-timeline">
        {newsItems.map((item) => (
          <li id={item.id}>
            <time datetime={item.data.date}>{formatDate(item.data.date, dateFormat)}</time>
            {item.data.link ? (
              <a
                href={item.data.link}
                target={isExternalHref(item.data.link) ? "_blank" : undefined}
                rel={isExternalHref(item.data.link) ? "noopener noreferrer" : undefined}
              >
                {item.data.title}
              </a>
            ) : (
              <span>{item.data.title}</span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
