---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getEntry } from "astro:content";
import { SITE_URL } from "../../data/site";
import { breadcrumbNode, graph, personNode, websiteNode } from "../../utils/schema";

const experience = await getEntry("pages", "experience");
const items = experience?.data.items ?? [];
const education = experience?.data.education ?? [];
const service = experience?.data.service ?? [];

const resumeHref = `${import.meta.env.BASE_URL}resume.pdf`;

const structuredData = graph([
  websiteNode(),
  personNode(education),
  breadcrumbNode([
    { name: "Home", url: `${SITE_URL}/` },
    { name: "Experience", url: `${SITE_URL}/experience/` },
  ]),
]);
---

<BaseLayout
  title="Experience"
  description="Roles, education, and professional service across selective prediction, calibration, multimodal evaluation, and LLM reliability."
  structuredData={structuredData}
>
  <section class="section">
    <div class="site-shell stack">
      <SectionHeading
        as="h1"
        eyebrow="Experience"
        title="Machine learning research and engineering."
      />

      <ol class="role-list">
        {items.map((item) => (
          <li class="role">
            <div class="role__meta">
              <p class="role__timeframe">{item.timeframe}</p>
              {item.location && <p class="role__location">{item.location}</p>}
            </div>
            <div class="role__body">
              <h2 class="role__title">{item.role}</h2>
              {item.bullets && item.bullets.length > 0 && (
                <ul class="role__bullets">
                  {item.bullets.map((bullet) => (
                    <li set:html={bullet} />
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>

      {education.length > 0 && (
        <section class="cv-block" aria-labelledby="education-heading">
          <h2 id="education-heading" class="cv-block__title">
            <span class="eyebrow">Education</span>
            The Ohio State University, start to finish.
          </h2>

          <ol class="role-list">
            {education.map((item) => (
              <li class="role">
                <div class="role__meta">
                  <p class="role__timeframe">{item.timeframe}</p>
                  {item.location && <p class="role__location">{item.location}</p>}
                </div>
                <div class="role__body">
                  <h3 class="role__title">
                    {item.degree} <span class="role__field">{item.field}</span>
                  </h3>
                  <p class="role__org">{item.institution}</p>
                  {item.notes && item.notes.length > 0 && (
                    <ul class="role__bullets">
                      {item.notes.map((note) => (
                        <li set:html={note} />
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      {service.length > 0 && (
        <section class="cv-block" aria-labelledby="service-heading">
          <h2 id="service-heading" class="cv-block__title">
            <span class="eyebrow">Service</span>
            Peer review and community.
          </h2>

          <dl class="service-list">
            {service.map((item) => (
              <div class="service-list__row">
                <dt>{item.role}</dt>
                <dd>
                  <ul>
                    {item.venues.map((venue) => (
                      <li>{venue}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <div>
        <a class="button button--ghost" href={resumeHref} target="_blank" rel="noopener noreferrer">
          Resume (PDF)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .role-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline-strong);
  }

  .role {
    display: grid;
    gap: 0.4rem 2rem;
    padding: 1.5rem 0;
    border-bottom: var(--hairline);
  }

  @media (min-width: 820px) {
    .role {
      grid-template-columns: minmax(11rem, 0.24fr) minmax(0, 1fr);
    }
  }

  .role__meta {
    min-width: 0;
  }

  .role__timeframe {
    margin: 0;
    color: var(--color-text);
    font: 600 var(--label-sm, 0.6875rem) / 1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .role__location {
    margin: 0.3rem 0 0;
    color: var(--color-text-soft);
    font-size: var(--text-sm, 0.9375rem);
    line-height: 1.5;
  }

  .role__body {
    min-width: 0;
  }

  .role__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .role__bullets {
    display: grid;
    gap: 0.5rem;
    margin: 0.7rem 0 0;
    padding-left: 1.05rem;
    max-width: 44rem;
    color: var(--color-text-muted);
    font-size: var(--text-md, 1rem);
    line-height: 1.65;
  }

  .role__field {
    color: var(--color-text-muted);
  }

  .role__org {
    margin: 0.3rem 0 0;
    color: var(--color-text-soft);
    font-size: var(--text-sm, 0.9375rem);
    line-height: 1.5;
  }

  .cv-block {
    display: grid;
    gap: 1.15rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .cv-block__title {
    display: grid;
    gap: 0;
    margin: 0;
    max-width: 34rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--display-3, clamp(1.75rem, 1.5rem + 1.1vw, 2.3rem));
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.02;
  }

  .service-list {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: var(--hairline-strong);
  }

  .service-list__row {
    display: grid;
    gap: 0.5rem 2rem;
    padding: 1.25rem 0;
    border-bottom: var(--hairline);
  }

  @media (min-width: 820px) {
    .service-list__row {
      grid-template-columns: minmax(11rem, 0.24fr) minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .service-list__row dt {
    color: var(--color-text);
    font: 600 var(--label-sm, 0.6875rem) / 1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .service-list__row dd {
    margin: 0;
  }

  .service-list__row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-list__row li {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.22rem 0.6rem;
    border: var(--hairline);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font: 600 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.04em;
  }
</style>
