---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getEntry } from "astro:content";
import { SITE_URL } from "../../data/site";
import { breadcrumbNode, graph, personNode, websiteNode } from "../../utils/schema";

const experience = await getEntry("pages", "experience");
const items = experience?.data.items ?? [];
const education = experience?.data.education ?? [];
const service = experience?.data.service ?? [];

const resumeHref = `${import.meta.env.BASE_URL}resume.pdf`;

const structuredData = graph([
  websiteNode(),
  personNode(education),
  breadcrumbNode([
    { name: "Home", url: `${SITE_URL}/` },
    { name: "Experience", url: `${SITE_URL}/experience/` },
  ]),
]);
---

<BaseLayout
  title="Experience"
  description="Roles, education, and service: DCS Corp (AFRL-sponsored), Ohio State’s Computer Vision Lab, and five summers of AFRL research internships. Available now for ML research and engineering roles."
  structuredData={structuredData}
>
  <section class="section">
    <div class="site-shell stack">
      <SectionHeading
        as="h1"
        index="04"
        eyebrow="Experience"
        title="AFRL-sponsored ML research every year since 2020."
        dim="DCS Corp since May 2025; Ohio State’s Computer Vision Lab, 2021–2026."
      />

      <ol class="role-list">
        {items.map((item, i) => (
          <li class="role">
            <div class="role__meta">
              <p class="role__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
              <p class="role__timeframe">{item.timeframe}</p>
              {item.location && <p class="role__location">{item.location}</p>}
            </div>
            <div class="role__body">
              <h2 class="role__title">{item.role}</h2>
              {item.bullets && item.bullets.length > 0 && (
                <ol class="role__bullets">
                  {item.bullets.map((bullet, j) => (
                    <li>
                      <span class="role__num" aria-hidden="true">{i + 1}.{j + 1}</span>
                      <span set:html={bullet} />
                    </li>
                  ))}
                </ol>
              )}
            </div>
          </li>
        ))}
      </ol>

      {education.length > 0 && (
        <section class="cv-block" aria-labelledby="education-heading">
          <h2 id="education-heading" class="cv-block__title">
            <span class="eyebrow"><span class="label__index">4.1</span><span>Education</span></span>
            The Ohio State University, start to finish.
          </h2>

          <ol class="role-list">
            {education.map((item) => (
              <li class="role">
                <div class="role__meta">
                  <p class="role__timeframe">{item.timeframe}</p>
                  {item.location && <p class="role__location">{item.location}</p>}
                </div>
                <div class="role__body">
                  <h3 class="role__title">
                    {item.degree} <span class="role__field">{item.field}</span>
                  </h3>
                  <p class="role__org">{item.institution}</p>
                  {item.notes && item.notes.length > 0 && (
                    <ul class="role__bullets">
                      {item.notes.map((note) => (
                        <li set:html={note} />
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      {service.length > 0 && (
        <section class="cv-block" aria-labelledby="service-heading">
          <h2 id="service-heading" class="cv-block__title">
            <span class="eyebrow"><span class="label__index">4.2</span><span>Service</span></span>
            Peer review and community.
          </h2>

          <dl class="service-list">
            {service.map((item) => (
              <div class="service-list__row">
                <dt>{item.role}</dt>
                <dd>
                  <ul>
                    {item.venues.map((venue) => (
                      <li>{venue}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <div>
        <a class="button button--ghost" href={resumeHref} target="_blank" rel="noopener noreferrer">
          Resume (PDF)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .role-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
  }

  .role {
    display: grid;
    gap: 0.75rem 2rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem) 0;
    border-bottom: var(--hairline);
  }

  @media (min-width: 820px) {
    .role {
      grid-template-columns: minmax(12rem, 0.28fr) minmax(0, 1fr);
    }
  }

  .role__meta {
    min-width: 0;
  }

  .role__index {
    margin: 0 0 0.75rem;
    color: var(--color-text);
    font: 500 var(--display-3) / 1 var(--font-mono);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .role__timeframe {
    margin: 0;
    color: var(--color-text);
    font: 500 var(--label-sm) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .role__location {
    margin: 0.3rem 0 0;
    color: var(--color-text-soft);
    font: 400 var(--label-md) / 1.5 var(--font-mono);
  }

  .role__body {
    min-width: 0;
  }

  .role__title {
    margin: 0;
    color: var(--color-text);
    font: 500 var(--display-4) / 1.3 var(--font-display);
    letter-spacing: -0.02em;
  }

  .role__bullets {
    display: grid;
    gap: 0;
    max-width: 48rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
  }

  .role__bullets li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.8rem 0;
    border-bottom: var(--hairline);
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: 1.6;
  }

  .role__bullets li :global(strong) {
    color: var(--color-text);
    font-weight: 500;
  }

  .role__num {
    color: var(--color-text-soft);
    font: 500 var(--label-md) / 2 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .role__field {
    color: var(--color-text-soft);
  }

  .role__org {
    margin: 0.3rem 0 0;
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .cv-block {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .cv-block__title {
    display: grid;
    gap: 0;
    max-width: 40rem;
    margin: 0;
    color: var(--color-text);
    font: 500 var(--display-2) / 1.08 var(--font-display);
    letter-spacing: var(--tracking-display);
  }

  .cv-block__title .eyebrow {
    letter-spacing: var(--tracking-label);
  }

  .service-list {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: var(--hairline);
  }

  .service-list__row {
    display: grid;
    gap: 0.6rem 2rem;
    padding: 1.25rem 0;
    border-bottom: var(--hairline);
  }

  @media (min-width: 820px) {
    .service-list__row {
      grid-template-columns: minmax(12rem, 0.28fr) minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .service-list__row dt {
    color: var(--color-text);
    font: 500 var(--label-sm) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .service-list__row dd {
    margin: 0;
  }

  .service-list__row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-list__row li {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.2rem 0.55rem;
    border: var(--hairline);
    color: var(--color-text-muted);
    font: 500 0.6875rem / 1.2 var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .role__bullets li {
      font-size: var(--text-sm);
    }
  }
</style>
