---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="The page you’re looking for doesn’t exist." noindex>
  <section class="site-shell section">
    <div class="surface surface--muted stack not-found">
      <span class="tag">404</span>
      <h1 class="hero__heading">That page wandered off.</h1>
      <p class="prose">
        Try heading back to the homepage or contact me if you think something’s broken.
      </p>
      <div class="hero__actions">
        <a class="button" href={import.meta.env.BASE_URL}>Return home</a>
        <a class="button button--ghost" href="mailto:kashanimotlagh.1@osu.edu">Email me</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: clamp(2rem, 4vw, 3.2rem);
  }

  .not-found .hero__heading {
    font-size: var(--display-2);
  }

  .not-found .prose {
    max-width: 48ch;
  }
</style>
