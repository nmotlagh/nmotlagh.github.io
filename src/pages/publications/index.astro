---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_URL } from '../../data/site';
import {
  breadcrumbNode,
  graph,
  personNode,
  publicationNode,
  publicationUrl,
  websiteNode,
} from '../../utils/schema';

const publications = (await getCollection('publications', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.year - a.data.year,
);
const isCurrentManuscript = (entry: CollectionEntry<'publications'>) =>
  entry.data.citation?.type === 'unpublished';
const currentManuscripts = publications.filter(isCurrentManuscript);
const peerReviewedPublications = publications.filter((entry) => !isCurrentManuscript(entry));
const artifactEntries = await getCollection('artifacts');
const artifactMap = new Map<string, CollectionEntry<'artifacts'>[]>();
artifactEntries.forEach((artifact) => {
  artifact.data.tiesTo.forEach((slug) => {
    if (!artifactMap.has(slug)) {
      artifactMap.set(slug, []);
    }
    artifactMap.get(slug)?.push(artifact);
  });
});

const experience = await getEntry('pages', 'experience');

const structuredData = graph([
  websiteNode(),
  {
    '@type': 'CollectionPage',
    '@id': `${SITE_URL}/publications/#page`,
    url: `${SITE_URL}/publications/`,
    name: 'Publications — Nick Kashani Motlagh',
    inLanguage: 'en-US',
    mainEntity: {
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: publications.length,
      // Peer-reviewed first, matching the page order.
      itemListElement: [...peerReviewedPublications, ...currentManuscripts].map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: publicationUrl(entry.slug),
        name: entry.data.title,
      })),
    },
  },
  personNode(experience?.data.education ?? []),
  ...publications.map(publicationNode),
  breadcrumbNode([
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Publications', url: `${SITE_URL}/publications/` },
  ]),
]);
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed papers and current manuscript notes spanning selective prediction, multimodal machine translation, and dependable LLM systems."
  structuredData={structuredData}
>
  <section class="section">
    <div class="site-shell archive-page">
      <div class="archive-page__header">
        <div>
          <SectionHeading
            as="h1"
            eyebrow="Publications"
            title="Four peer-reviewed first-author papers."
          />
        </div>

      </div>

      <section class="publication-group" aria-labelledby="peer-reviewed-heading">
        <div class="publication-group__heading">
          <p class="eyebrow">Peer-reviewed</p>
          <h2 id="peer-reviewed-heading">Published papers</h2>
        </div>
        <div class="publication-grid grid grid--2 archive-page__grid">
          {peerReviewedPublications.map((pub) => (
            <PublicationCard entry={pub} artifacts={artifactMap.get(pub.slug)} />
          ))}
        </div>
      </section>

      {currentManuscripts.length > 0 && (
        <section class="publication-group" aria-labelledby="current-manuscripts-heading">
          <div class="publication-group__heading">
            <p class="eyebrow">Not yet peer-reviewed</p>
            <h2 id="current-manuscripts-heading">Current manuscripts</h2>
          </div>
          <div class="publication-grid grid grid--2 archive-page__grid">
            {currentManuscripts.map((pub) => (
              <PublicationCard entry={pub} artifacts={artifactMap.get(pub.slug)} />
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .publication-group {
    display: grid;
    gap: 1rem;
  }

  .publication-group__heading h2 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.02;
  }
</style>
