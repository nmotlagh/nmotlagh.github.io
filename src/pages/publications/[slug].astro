---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CiteBlock from '../../components/CiteBlock.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE_URL } from '../../data/site';
import { toBibtex } from '../../utils/bibtex';
import {
  breadcrumbNode,
  graph,
  personNode,
  publicationNode,
  websiteNode,
} from '../../utils/schema';

export async function getStaticPaths() {
  const publications = await getCollection('publications', ({ data }) => !data.draft);
  return publications.map((pub) => ({
    params: { slug: pub.slug },
    props: { pub },
  }));
}

const { pub } = Astro.props;
const rendered = await pub.render();
const artifacts = await getCollection('artifacts');
const relatedArtifacts = artifacts.filter((artifact) => artifact.data.tiesTo.includes(pub.slug));
const LEAD_AUTHOR = 'Kashani Motlagh';
const isLeadAuthor = (author: string) => author.includes(LEAD_AUTHOR);
const isFirstAuthor = isLeadAuthor(pub.data.authors[0] ?? '');
const primaryHref = pub.data.external ?? pub.data.pdf;
const badges = [
  primaryHref && { label: 'Paper', href: primaryHref },
  pub.data.arxiv && pub.data.arxiv !== primaryHref && { label: 'arXiv', href: pub.data.arxiv },
  pub.data.code && { label: 'Code', href: pub.data.code },
  pub.data.data && { label: 'Data', href: pub.data.data },
  pub.data.slides && { label: 'Slides', href: pub.data.slides },
].filter(Boolean) as { label: string; href: string }[];
const experience = await getEntry('pages', 'experience');
const bibtex = toBibtex(pub);
const bibHref = `${import.meta.env.BASE_URL}publications/${pub.slug}.bib`;

const structuredData = graph([
  websiteNode(),
  personNode(experience?.data.education ?? []),
  publicationNode(pub),
  breadcrumbNode([
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Publications', url: `${SITE_URL}/publications/` },
    { name: pub.data.title, url: `${SITE_URL}/publications/${pub.slug}/` },
  ]),
]);
---

<BaseLayout title={pub.data.title} description={pub.data.tldr} structuredData={structuredData}>
  <section class="section">
    <article class="site-shell detail-page">
      <a class="detail-backlink" href={`${import.meta.env.BASE_URL}publications/`}>
        ← Back to publications
      </a>

      <header class="detail-page__hero surface surface--raised">
        <div>
          <div class="detail-page__eyebrow-row">
            <p class="eyebrow">{pub.data.venue} / {pub.data.year}</p>
            {isFirstAuthor && <span class="detail-page__role">First author</span>}
          </div>
          <h1>{pub.data.title}</h1>
          <p class="detail-page__byline">
            {pub.data.authors.map((author, index) => (
              <span class:list={['detail-author', isLeadAuthor(author) && 'detail-author--lead']}>
                {author}{index < pub.data.authors.length - 1 ? ', ' : ''}
              </span>
            ))}
          </p>

          {badges.some((badge) => Boolean(badge.href)) && (
            <div class="detail-page__meta">
              {badges.map(
                (badge) =>
                  badge.href && (
                    <a
                      class="badge badge--link"
                      aria-label={`${badge.label} for ${pub.data.title}`}
                      href={badge.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {badge.label}
                    </a>
                  ),
              )}
            </div>
          )}
        </div>

        <div class="detail-page__aside">
          {(pub.data.metric || pub.data.award) && (
            <aside class="detail-note surface">
              <p class="eyebrow">Signal</p>
              <p style="margin: 0; color: var(--color-text); font-family: var(--font-display); font-size: 1.4rem; line-height: 1.08;">
                {pub.data.metric ?? pub.data.award}
              </p>
            </aside>
          )}

          <aside class="detail-note surface">
            <p class="eyebrow">Summary</p>
            <p style="margin: 0;">{pub.data.tldr}</p>
          </aside>
        </div>
      </header>

      <div class="detail-page__grid">
        <div class="detail-page__main">
          <section class="detail-page__content surface" style="padding: clamp(1.3rem, 3vw, 2.2rem);">
            <div class="prose">
              <rendered.Content />
            </div>
          </section>

          <CiteBlock bibtex={bibtex} downloadHref={bibHref} />
        </div>

        <aside class="detail-page__aside">
          {pub.data.highlights && pub.data.highlights.length > 0 && (
            <section class="detail-note surface">
              <h2>Highlights</h2>
              <ul>
                {pub.data.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </section>
          )}

          {relatedArtifacts.length > 0 && (
            <section class="detail-note surface">
              <h2>Related code and data</h2>
              <ul>
                {relatedArtifacts.map((artifact) => (
                  <li>
                    <a href={artifact.data.repo} target="_blank" rel="noopener noreferrer">
                      {artifact.data.name}
                    </a>
                    <br />
                    <span>{artifact.data.summary}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </article>
  </section>
</BaseLayout>
