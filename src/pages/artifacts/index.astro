---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE_URL } from '../../data/site';
import { artifactNode, breadcrumbNode, graph, personNode, websiteNode } from '../../utils/schema';

const artifacts = (await getCollection('artifacts')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const publications = await getCollection('publications', ({ data }) => !data.draft);
const publicationLookup = new Map(publications.map((pub) => [pub.id, pub.data.title]));
const experience = await getEntry('pages', 'experience');

const structuredData = graph([
  websiteNode(),
  {
    '@type': 'CollectionPage',
    '@id': `${SITE_URL}/artifacts/#page`,
    url: `${SITE_URL}/artifacts/`,
    name: 'Code and data — Nick Kashani Motlagh',
    inLanguage: 'en-US',
  },
  personNode(experience?.data.education ?? []),
  ...artifacts.map(artifactNode),
  breadcrumbNode([
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Code & data', url: `${SITE_URL}/artifacts/` },
  ]),
]);
---

<BaseLayout
  title="Code & Data"
  description="Public research repositories and datasets from my papers, each with what it reproduces."
  structuredData={structuredData}
>
  <section class="section">
    <div class="site-shell archive-page">
      <div class="archive-page__header">
        <div>
          <SectionHeading
            as="h1"
            index="02"
            eyebrow="Work · Code and data"
            title="Research code and datasets."
          />
        </div>

      </div>

      <div class="grid grid--2 archive-page__grid">
        {artifacts.map((artifact, i) => {
          const tiedPublications = artifact.data.tiesTo
            .map((slug) => ({ slug, title: publicationLookup.get(slug) }))
            .filter((item): item is { slug: string; title: string } => Boolean(item.title));
          return (
            <article class="artifact-archive-card surface">
              <p class="fig-label" aria-hidden="true">2.{i + 1}</p>
              <p class="artifact-archive-card__repo">{artifact.data.repo.replace('https://github.com/', '')}</p>
              <div class="artifact-card__header">
                <h2>
                  <a href={artifact.data.repo} target="_blank" rel="noopener noreferrer">
                    {artifact.data.name}
                  </a>
                </h2>
                <a
                  class="badge badge--link"
                  href={artifact.data.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`GitHub repository for ${artifact.data.name}`}
                >
                  GitHub
                </a>
              </div>
              <p>{artifact.data.summary}</p>
              {artifact.data.stack && artifact.data.stack.length > 0 && (
                <ul class="artifact-archive-card__stack">
                  {artifact.data.stack.map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
              )}
              <ol class="artifact-archive-card__steps">
                {artifact.data.reproduce.map((item) => (
                  <li>{item}</li>
                ))}
              </ol>
              {tiedPublications.length > 0 && (
                <p class="artifact-card__ties">
                  <span class="artifact-card__ties-label">Supports</span>
                  {tiedPublications.map((item, index) => (
                    <span>
                      <a href={`${import.meta.env.BASE_URL}publications/${item.slug}/`}>{item.title}</a>
                      {index < tiedPublications.length - 1 ? ', ' : ''}
                    </span>
                  ))}
                </p>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .artifact-archive-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: calc(var(--pad-slab) + 1.25rem) var(--pad-slab) var(--pad-slab);
    transition: background-color var(--transition-fast);
  }

  .artifact-archive-card:hover,
  .artifact-archive-card:focus-within {
    background: var(--color-bg-alt);
  }

  .artifact-archive-card__repo {
    margin: 0 0 0.6rem;
    color: var(--color-text-soft);
    font: 400 var(--label-md) / 1.4 var(--font-mono);
    overflow-wrap: anywhere;
  }

  .artifact-card__header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
  }

  .artifact-card__header h2 {
    margin: 0;
    font: 500 var(--display-3) / 1.15 var(--font-display);
    letter-spacing: -0.025em;
  }

  .artifact-card__header h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .artifact-card__header h2 a:hover,
  .artifact-card__header h2 a:focus-visible {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .artifact-archive-card p {
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .artifact-archive-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .artifact-archive-card__stack li {
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
    padding: 0.2rem 0.5rem;
    border: var(--hairline);
    color: var(--color-text-soft);
    font: 500 0.625rem / 1.2 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .artifact-archive-card__steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
    counter-reset: step;
  }

  .artifact-archive-card__steps li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.75rem 0;
    border-bottom: var(--hairline);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    counter-increment: step;
  }

  .artifact-archive-card__steps li::before {
    content: counter(step, decimal-leading-zero);
    color: var(--color-text-soft);
    font: 500 var(--label-md) / 1.9 var(--font-mono);
  }

  .artifact-card__ties {
    margin: auto 0 0;
    padding-top: 1.25rem;
    font-size: var(--text-sm);
  }

  .artifact-card__ties-label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-text-soft);
    font: 500 var(--label-sm) / 1.3 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .artifact-archive-card {
      padding: calc(var(--pad-card) + 1.25rem) var(--pad-card) var(--pad-card);
    }

    .artifact-card__header {
      display: grid;
    }

    .artifact-card__header h2 a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
